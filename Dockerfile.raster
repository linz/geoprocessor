FROM ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 AS uv_source

# LINZ's GDAL base image, from https://github.com/linz/geocontainers. Dependabot updates its tag and digest.
FROM ghcr.io/linz/li-gdal-docker:3.13.3@sha256:12015262413415a657c7dfc9a18c0e6c8971cff62ba9adb5f2de2d6b54575e59 AS builder

COPY --from=uv_source /uv /bin/

WORKDIR /build

COPY uv.lock pyproject.toml /build/
COPY ./packages/ /build/packages/

# Our packages go in a virtual environment on the base image's Python (conda-forge).
# GDAL's Python scripts (gdal_edit, gdal_fillnodata) keep running in the base image's environment, which has the GDAL bindings.
ENV UV_PROJECT_ENVIRONMENT=/venv
ENV UV_PYTHON=$CONDA_PREFIX/bin/python
ENV UV_PYTHON_PREFERENCE=only-system

RUN uv sync --frozen --no-dev --no-editable --package geoprocessor-raster

FROM ghcr.io/linz/li-gdal-docker:3.13.3@sha256:12015262413415a657c7dfc9a18c0e6c8971cff62ba9adb5f2de2d6b54575e59

ARG GIT_HASH
ENV GIT_HASH=$GIT_HASH
ARG GIT_VERSION
ENV GIT_VERSION=$GIT_VERSION

COPY --from=builder /venv /venv

ENV PATH="/venv/bin:$PATH"
# TODO: Is this still needed?
ENV GTIFF_SRS_SOURCE="EPSG"

WORKDIR /app

ENTRYPOINT ["tini", "--"]
