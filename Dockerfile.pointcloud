FROM ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 AS uv_source

# LINZ's PDAL base image, from https://github.com/linz/geocontainers. Dependabot updates its tag and digest.
FROM ghcr.io/linz/li-pdal-docker:2.10.2@sha256:6b6860328c53da7a0e73426bc5af3917de7a628a4929103afd0757132fa76e1b AS builder

COPY --from=uv_source /uv /bin/

WORKDIR /build

COPY uv.lock pyproject.toml /build/
COPY ./packages/ /build/packages/

# Our packages go in a virtual environment on the base image's Python (conda-forge)
ENV UV_PROJECT_ENVIRONMENT=/venv
ENV UV_PYTHON=$CONDA_PREFIX/bin/python
ENV UV_PYTHON_PREFERENCE=only-system

RUN uv sync --frozen --no-dev --no-editable --package geoprocessor-pointcloud

FROM ghcr.io/linz/li-pdal-docker:2.10.2@sha256:6b6860328c53da7a0e73426bc5af3917de7a628a4929103afd0757132fa76e1b

ARG GIT_HASH
ENV GIT_HASH=$GIT_HASH
ARG GIT_VERSION
ENV GIT_VERSION=$GIT_VERSION

COPY --from=builder /venv /venv

ENV PATH="/venv/bin:$PATH"

WORKDIR /app

ENTRYPOINT ["tini", "--"]
