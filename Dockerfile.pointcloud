FROM ghcr.io/astral-sh/uv:0.13.6@sha256:af22a52f5eafef3d78e551599d405c02df61919d18028f0cea8eda93bc9986d0 AS uv_source

FROM ghcr.io/linz/pdal-docker:2.10.2@sha256:406bd6bc89ff874b4747b27700daf4c61bc2ba77fade3434eb8e96d688ba33b5 AS builder

COPY --from=uv_source /uv /uvx /bin/

WORKDIR /build

COPY uv.lock pyproject.toml /build/
COPY ./packages/ /build/packages/

ENV UV_PROJECT_ENVIRONMENT=/venv
ENV UV_PYTHON=/usr/bin/python3
ENV UV_PYTHON_PREFERENCE=only-system

RUN apt-get update \
    && apt-get install --assume-yes --no-install-recommends tini

RUN uv sync --frozen --no-dev --no-editable --package geoprocessor-pointcloud

FROM ghcr.io/linz/pdal-docker:2.10.2@sha256:406bd6bc89ff874b4747b27700daf4c61bc2ba77fade3434eb8e96d688ba33b5

ARG GIT_HASH
ENV GIT_HASH=$GIT_HASH
ARG GIT_VERSION
ENV GIT_VERSION=$GIT_VERSION

COPY --from=builder /usr/bin/tini /usr/bin/tini
COPY --from=builder /venv /venv

ENV PATH="/venv/bin:$PATH"

WORKDIR /app

ENTRYPOINT ["/usr/bin/tini", "--"]
