FROM ghcr.io/astral-sh/uv:0.13.9@sha256:d3b601f0c7b118bc1753febf7c41cc80981df678445e0254284eecf84db79a7d AS uv_source

# LINZ's PDAL base image, from https://github.com/linz/geocontainers. Dependabot updates its tag and digest.
FROM ghcr.io/linz/li-pdal-docker:2.10.2@sha256:93a6009130696931afd511946eb00619ab9e79fa9d347b18b561c6280afa8d72 AS builder

COPY --from=uv_source /uv /bin/

WORKDIR /build

COPY uv.lock pyproject.toml /build/
COPY ./packages/ /build/packages/

# Our packages go in a virtual environment on the base image's Python (conda-forge)
ENV UV_PROJECT_ENVIRONMENT=/venv
ENV UV_PYTHON=$CONDA_PREFIX/bin/python
ENV UV_PYTHON_PREFERENCE=only-system

RUN uv sync --frozen --no-dev --no-editable --package geoprocessor-pointcloud

FROM ghcr.io/linz/li-pdal-docker:2.10.2@sha256:93a6009130696931afd511946eb00619ab9e79fa9d347b18b561c6280afa8d72

ARG GIT_HASH
ENV GIT_HASH=$GIT_HASH
ARG GIT_VERSION
ENV GIT_VERSION=$GIT_VERSION

COPY --from=builder /venv /venv

ENV PATH="/venv/bin:$PATH"

WORKDIR /app

ENTRYPOINT ["tini", "--"]
