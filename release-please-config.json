    ".": {
      "include-component-in-tag": false,
      "extra-files": [
        {
          "path": "uv.lock",
          "type": "toml",
          "jsonpath": "$.package[?(@.name.value=='geoprocessor')].version"
        }
      ]
    },
    "packages/geoprocessor-common": {
